# ==============================================================================
# VARP Premium Payment Gateway Configuration (Sandbox / Test Mode)
# ==============================================================================
# Copy this file to .env in your project root (C:\xampp\htdocs\dbwproject\.env)
# and fill in your test credentials from https://dashboard.razorpay.com/#/app/keys

PAYMENT_GATEWAY_MODE=sandbox

# Razorpay Test Key ID (starts with rzp_test_)
RAZORPAY_KEY_ID=

# Razorpay Test Key Secret
RAZORPAY_KEY_SECRET=

# Razorpay Webhook Secret (configured in Razorpay Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# Pricing Details
PREMIUM_PLAN_PRICE_INR=99.00
PREMIUM_PLAN_CURRENCY=INR
